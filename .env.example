# Never commit real private keys, seed phrases, or OTP values.

X_LAYER_RPC_URL=https://rpc.xlayer.tech
X_LAYER_CHAIN_ID=196

# Foundry keystore account name, created with:
# cast wallet import <name> --interactive
FOUNDRY_ACCOUNT=okx-agentic
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# Project roles.
TREASURY_OWNER=0x0000000000000000000000000000000000000000
AGENT_ADDRESS=0x0000000000000000000000000000000000000000
SIGNAL_REPORTER=0x0000000000000000000000000000000000000000

# Token pair for the X Layer v4 pool. Use small demo amounts for first review.
TOKEN0=0x0000000000000000000000000000000000000000
TOKEN1=0x0000000000000000000000000000000000000000

# Set after script/00_DeployHook.s.sol succeeds.
HOOK_ADDRESS=0x0000000000000000000000000000000000000000

# Set after script/03_DeployAgentTreasury.s.sol succeeds.
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional demo router / swap proof.
SWAP_ROUTER=0x0000000000000000000000000000000000000000

# Optional for demo token deployment.
DEMO_TOKEN_SUPPLY=1000000000000000000000000
